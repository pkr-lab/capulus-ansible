[Unit]
Description=Copy k3s etcd snapshots to the NAS
After=network-online.target
Wants=network-online.target
RequiresMountsFor={{ k3s_snapshot_mount_point }}

[Service]
Type=oneshot
Environment=SNAPSHOT_DIR={{ k3s_snapshot_dir }}
Environment=MOUNT_POINT={{ k3s_snapshot_mount_point }}
Environment=KEEP_DAYS={{ k3s_snapshot_copy_keep_days }}
Environment=NODE_NAME={{ k3s_node_name }}
ExecStart=/usr/local/bin/k3s-etcd-snapshot-copy.sh
