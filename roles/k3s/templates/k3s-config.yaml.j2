---
# k3s server configuration — generated by Ansible, do not edit manually.
write-kubeconfig-mode: "0600"
{% if k3s_mode == 'single' %}
tls-san:
  - "{{ k3s_server_ip }}"
  - "{{ hostname }}"
  - "127.0.0.1"
{% else %}
{% if k3s_mode == 'init' %}
cluster-init: true
{% else %}
server: "https://{{ hostvars[k3s_primary_host]['ansible_host'] }}:6443"
token: "{{ k3s_join_token }}"
{% endif %}
tls-san:
  - "127.0.0.1"
{% for h in groups['k3s_servers'] %}
  - "{{ hostvars[h]['ansible_host'] }}"
  - "{{ h }}"
{% if hostvars[h]['k3s_node_name'] is defined and hostvars[h]['k3s_node_name'] != h %}
  - "{{ hostvars[h]['k3s_node_name'] }}"
{% endif %}
{% endfor %}
{% for san in k3s_tls_san_extra %}
  - "{{ san }}"
{% endfor %}
etcd-arg:
  - "heartbeat-interval={{ k3s_etcd_heartbeat_interval_ms }}"
  - "election-timeout={{ k3s_etcd_election_timeout_ms }}"
etcd-expose-metrics: {{ k3s_etcd_expose_metrics | bool | lower }}
etcd-snapshot-schedule-cron: "{{ k3s_etcd_snapshot_cron }}"
etcd-snapshot-retention: {{ k3s_etcd_snapshot_retention }}
etcd-snapshot-compress: {{ k3s_etcd_snapshot_compress | bool | lower }}
{% if k3s_node_taints | length > 0 %}
node-taint:
{% for taint in k3s_node_taints %}
  - "{{ taint }}"
{% endfor %}
{% endif %}
{% endif %}
cluster-cidr: "{{ k3s_pod_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
node-name: "{{ k3s_node_name }}"
# Ubuntu systemd-resolved stellt /etc/resolv.conf auf 127.0.0.53 (Stub),
# der aus dem Pod-Netz nicht erreichbar ist. CoreDNS bekommt damit keine
# Upstream-DNS-Server und kann externe Namen (github.com etc.) nicht auflösen.
resolv-conf: {{ k3s_resolv_conf_path }}
{% if k3s_secrets_encryption_enabled | bool %}
# Security-Härtung Phase 4 (docs/d-sicherheit/d0010-security-hardening-roadmap.md, docs/d-sicherheit/d0050-secrets-encryption-audit-log.md).
# Verschlüsselt Secrets im k3s-Datastore (state.db) selbst — Sealed Secrets
# schützt nur den Git-Zustand, ohne dieses Flag liegen entschlüsselte
# Secrets im Klartext auf der Platte.
# ACHTUNG: Diese Zeile allein aktiviert noch nichts — k3s liest config.yaml
# nur beim Start. Erst nach einem manuellen, bewussten
# `sudo systemctl restart k3s` (siehe docs/d-sicherheit/d0050-secrets-encryption-audit-log.md, inkl. vorherigem Backup und
# dem anschließenden `rotate-keys`-Schritt) wirkt sich das aus.
secrets-encryption: true
{% endif %}
{% if k3s_audit_log_enabled | bool %}
# Security-Härtung Phase 4: Audit-Log für den kube-apiserver. Policy-Datei
# unter /etc/rancher/k3s/audit-policy.yaml (separat von diesem Task
# templated, siehe ansible/roles/k3s/tasks/main.yml). Retention bewusst
# begrenzt (14 Tage / 5 Backups / 100 MB je Datei) — ausreichend für
# Nachvollziehbarkeit nach einem Incident, ohne die lokale SSD unbegrenzt
# wachsen zu lassen.
kube-apiserver-arg:
  - "audit-policy-file=/etc/rancher/k3s/audit-policy.yaml"
  - "audit-log-path=/var/log/k3s/audit.log"
  - "audit-log-maxage={{ k3s_audit_log_max_age_days }}"
  - "audit-log-maxbackup={{ k3s_audit_log_max_backups }}"
  - "audit-log-maxsize={{ k3s_audit_log_max_size_mb }}"
{% endif %}
{% if k3s_kubelet_memory_protection_enabled | bool %}
# RAM-Schutz auf Kubelet-Ebene: reserviert RAM für OS/kubelet/containerd,
# damit Pod-Speicherdruck nicht Systemdienste wie sshd/tailscaled treffen
# kann, und lässt den Kubelet betroffene Pods evakuieren/OOM-killen,
# BEVOR resource_watchdog (ansible/roles/resource_watchdog) bei 90%
# sustained den kompletten Node abschaltet. eviction-hard-Schwelle bewusst
# unter den 90% des resource_watchdog, damit Kubernetes zuerst eine
# Chance zur geordneten Reaktion bekommt (siehe
# docs/2-betrieb-hardware/20020-cluster-power-manager.md →
# "Mehrschichtiger RAM-Schutz").
kubelet-arg:
  - "eviction-hard=memory.available<{{ k3s_kubelet_eviction_hard_memory }}"
  - "system-reserved=memory={{ k3s_kubelet_system_reserved_memory }}"
  - "kube-reserved=memory={{ k3s_kubelet_kube_reserved_memory }}"
{% endif %}
