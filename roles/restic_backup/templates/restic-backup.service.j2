[Unit]
Description=Restic Backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ restic_backup_user }}
EnvironmentFile={{ restic_backup_config_dir }}/env
ExecStart=/usr/bin/restic backup --exclude-caches --exclude-file={{ restic_backup_config_dir }}/excludes {{ restic_backup_paths | join(' ') }}
Nice=19
IOSchedulingClass=idle
