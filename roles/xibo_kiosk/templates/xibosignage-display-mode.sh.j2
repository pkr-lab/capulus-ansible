#!/usr/bin/env bash
set -u
export LC_ALL=C

SCREEN_FILE=/dev/shm/xibosignage-screen
POLL_SECONDS={{ xibo_kiosk_display_poll_seconds }}
FORCED_MODE="{{ xibo_kiosk_display_mode }}"
PIXEL_ASPECT="{{ xibo_kiosk_pixel_aspect }}"

mode_listed() {
  awk -v o="$2" -v m="$3" '
    $1 == o {found = 1; next}
    found && /^[^ ]/ {found = 0}
    found && $1 == m {hit = 1}
    END {exit hit ? 0 : 1}
  ' <<<"$1"
}

pixel_aspect() {
  local info line mm_regex geometry_regex
  case "$PIXEL_ASPECT" in
    off|"") return 0 ;;
    auto) ;;
    *) printf '%s\n' "$PIXEL_ASPECT"; return 0 ;;
  esac
  info=$(xrandr --query 2>/dev/null) || return 0
  line=$(awk '/ connected/ {print; exit}' <<<"$info")
  mm_regex='([0-9]+)mm x ([0-9]+)mm'
  geometry_regex='([0-9]+)x([0-9]+)\+[0-9]+\+[0-9]+'
  [[ "$line" =~ $mm_regex ]] || return 0
  local mm_width="${BASH_REMATCH[1]}" mm_height="${BASH_REMATCH[2]}"
  [[ "$line" =~ $geometry_regex ]] || return 0
  local px_width="${BASH_REMATCH[1]}" px_height="${BASH_REMATCH[2]}"
  awk -v mw="$mm_width" -v mh="$mm_height" -v pw="$px_width" -v ph="$px_height" '
    BEGIN {
      if (mw < 100 || mh < 100 || pw < 1 || ph < 1) exit
      k = (mw / mh) / (pw / ph)
      if (k < 0.5 || k > 3 || (k > 0.92 && k < 1.08)) exit
      printf "%.3f\n", k
    }
  '
}

add_mode() {
  local output="$1" spec="$2" width height modeline name
  [[ "$spec" =~ ^([0-9]+)x([0-9]+)$ ]] || return 1
  width="${BASH_REMATCH[1]}"
  height="${BASH_REMATCH[2]}"
  modeline=$(cvt "$width" "$height" 2>/dev/null | awk '/Modeline/ {$1 = ""; print}')
  modeline=${modeline//\"/}
  [ -n "$modeline" ] || return 1
  name=$(awk '{print $1}' <<<"$modeline")
  xrandr --newmode $modeline >/dev/null 2>&1 || true
  xrandr --addmode "$output" "$name" >/dev/null 2>&1 || return 1
  printf '%s\n' "$name"
}

write_screen() {
  local size="$1 $2"
  if [ "$(cat "$SCREEN_FILE" 2>/dev/null)" != "$size" ]; then
    printf '%s\n' "$size" >"$SCREEN_FILE.tmp" && chmod 644 "$SCREEN_FILE.tmp" && mv "$SCREEN_FILE.tmp" "$SCREEN_FILE"
    logger -t xibosignage-display "bildschirm erkannt: $size"
  fi
}

# Setzt den Bildschirm fest auf FORCED_MODE; kein Scan nach der tatsaechlichen Aufloesung.
apply_once() {
  local info output current wanted=""
  info=$(xrandr --query 2>/dev/null) || return 1
  output=$(awk '/ connected/ {print $1; exit}' <<<"$info")
  [ -n "$output" ] || return 1

  current=$(awk -v o="$output" '
    $1 == o {found = 1; next}
    found && /^[^ ]/ {found = 0}
    found && /\*/ {print $1; exit}
  ' <<<"$info")

  if mode_listed "$info" "$output" "$FORCED_MODE"; then
    wanted=$FORCED_MODE
  else
    wanted=$(add_mode "$output" "$FORCED_MODE")
  fi

  if [ -z "$wanted" ]; then
    logger -t xibosignage-display "Modus $FORCED_MODE auf $output nicht verfuegbar"
    return 1
  fi

  if [ "$wanted" != "${current:-}" ]; then
    logger -t xibosignage-display "setze Modus $wanted auf $output (vorher ${current:-keiner})"
    xrandr --output "$output" --mode "$wanted" >/dev/null 2>&1 || true
  fi

  write_screen "${FORCED_MODE%x*}" "${FORCED_MODE#*x}"
}

if [ "${1:-}" = "once" ]; then
  apply_once
  exit 0
fi

if [ "${1:-}" = "par" ]; then
  pixel_aspect
  exit 0
fi

while true; do
  apply_once || true
  sleep "$POLL_SECONDS"
done
