[Unit]
Description=xibosignage X11-Server
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service systemd-udevd.service systemd-udev-trigger.service plymouth-start.service glamor-test.service
Before=xibosignage-kiosk.service shutdown.target
Conflicts=shutdown.target
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=xibosignage
RuntimeDirectoryMode=0755
ExecStartPre=-/usr/bin/plymouth quit
ExecStartPre=/bin/sh -c 'f=/run/xibosignage/Xauthority; : > "$$f"; xauth -f "$$f" add :0 . "$$(mcookie)"; chown root:{{ xibo_kiosk_user }} "$$f"; chmod 640 "$$f"'
ExecStart=/usr/lib/xorg/Xorg :0 vt7 -nolisten tcp -noreset -s 0 -dpms -auth /run/xibosignage/Xauthority
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
